   "source": [
    "#task question\n",
    "1.prop of sets?\n",
    "--it is unordered\n",
    "--it allow immutable datatypes\n",
    "--it not allow duplicate value\n",
    "--it is mutable\n",
    "\n",
    "2.diff b/w list & set?\n",
    "--list is ordered               --set is unordered\n",
    "--it allow duplicate value      --it not allow duplicate value\n",
    "--it allow all datatypes        --it allows immutable datatypes\n",
    "--it is immutable               --it is mutable\n",
    "\n",
    "3.diff b/w mutable & immutable ?\n",
    "--mutable can change index after creation       --immutable cannot change index after                                                    creation\n",
    "   --list,set                                          --tuple\n",
    "\n",
    "4.explain sum method in set?\n",
    "--add the new element\n",
    "  num={1,2,3,4,6,7,8,\"kishore\"}\n",
    "  num\n",
    "  num.add(5)\n",
    "  num\n",
    "\n",
    "5.explain sum method in list?\n",
    "--add index in particular place\n",
    "  num=[1,3,5,8,9,0,\"kishore\"]\n",
    "  num\n",
    "  num.index(4,\"king\")\n",
    "  num\n",
    "\n",
    "6.explain sum method in string?\n",
    "\n",
    "7.conditional statement?\n",
    "--condition statement is able work based on certain conoditions.\n",
    "types are:\n",
    "   --if else\n",
    "   --else if\n",
    "   --nested if\n",
    "   --ladder if\n",
    "\n",
    "\n"
   ]
  },
