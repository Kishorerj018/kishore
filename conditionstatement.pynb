   "source": [
    "num=int(input(\"enter the number\"))\n",
    "\n",
    "if num>0:\n",
    "    print(\"positive\")\n",
    "    if num%2==0:\n",
    "        print(\"even\")\n",
    "    else:\n",
    "        print(\"odd\")\n",
    "elif num<0:\n",
    "    print(\"negative\")\n",
    "    if num%5==0:\n",
    "        print(\"it is div by 5\")\n",
    "    else:\n",
    "        print(\"it is not div by 5\")\n",
    "else:\n",
    "    print(\"zero\")"
   ]
